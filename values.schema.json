{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rulebricks Chart Values",
  "description": "Configuration values for the Rulebricks umbrella chart.",
  "type": "object",
  "required": ["global"],
  "properties": {
    "global": {
      "type": "object",
      "required": ["domain", "email"],
      "properties": {
        "domain": {
          "type": "string",
          "minLength": 1,
          "description": "Base domain for the deployment (e.g., rb.example.com)"
        },
        "email": {
          "type": "string",
          "minLength": 1,
          "description": "Admin email (required for TLS certificates)"
        },
        "licenseKey": {
          "type": "string",
          "description": "Rulebricks license key"
        },
        "tlsEnabled": {
          "type": "boolean",
          "description": "Enable TLS/HTTPS"
        },
        "externalDnsEnabled": {
          "type": "boolean",
          "description": "Enable external-dns integration for automatic DNS record management"
        },
        "smtp": {
          "type": "object",
          "description": "SMTP Configuration",
          "properties": {
            "host": { "type": "string" },
            "port": { "type": "integer" },
            "user": { "type": "string" },
            "pass": { "type": "string" },
            "from": { "type": "string" },
            "fromName": { "type": "string" }
          }
        },
        "supabase": {
          "type": "object",
          "description": "Auth/Database Configuration",
          "properties": {
            "anonKey": { "type": "string" },
            "serviceKey": { "type": "string" },
            "url": { "type": "string" },
            "projectRef": { "type": "string" },
            "accessToken": { "type": "string" },
            "jwtSecret": { "type": "string" },
            "emails": {
              "type": "object",
              "properties": {
                "subjects": { "type": "object" },
                "templates": { "type": "object" }
              }
            }
          }
        },
        "ai": {
          "type": "object",
          "description": "AI Features Configuration",
          "properties": {
            "enabled": { "type": "boolean" },
            "openaiApiKey": { "type": "string" }
          }
        },
        "secrets": {
          "type": "object",
          "description": "Secrets Configuration",
          "properties": {
            "secretRef": { "type": "string" },
            "secretRefKeys": { "type": "object" }
          }
        },
        "sso": {
          "type": "object",
          "description": "Enterprise SSO Configuration",
          "properties": {
            "enabled": { "type": "boolean" },
            "provider": { 
              "type": "string",
              "enum": ["azure", "google", "okta", "keycloak", "ory", "other", ""]
            },
            "url": { "type": "string" },
            "clientId": { "type": "string" },
            "clientSecret": { "type": "string" }
          }
        },
        "externalAuth": {
          "type": "object",
          "description": "External Authentication / Token Passthrough for proxy-gated deployments",
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "header": { "type": "string", "default": "Authorization" },
            "claims": {
              "type": "object",
              "properties": {
                "id": { "type": "string", "default": "sub" },
                "email": { "type": "string", "default": "email" },
                "name": { "type": "string", "default": "name" }
              }
            },
            "publicPaths": {
              "type": "array",
              "items": { "type": "string" },
              "description": "URL-path prefixes that bypass the token check"
            }
          }
        },
        "labels": {
          "type": "object",
          "description": "Global labels applied to all resources",
          "additionalProperties": { "type": "string" }
        },
        "annotations": {
          "type": "object",
          "description": "Global annotations applied to all resources",
          "additionalProperties": { "type": "string" }
        },
        "podLabels": {
          "type": "object",
          "description": "Labels applied to all pod templates",
          "additionalProperties": { "type": "string" }
        },
        "podAnnotations": {
          "type": "object",
          "description": "Annotations applied to all pod templates",
          "additionalProperties": { "type": "string" }
        },
        "scheduling": {
          "type": "object",
          "description": "Global scheduling defaults",
          "properties": {
            "nodeSelector": {
              "type": "object",
              "description": "Node selector applied to all workloads",
              "additionalProperties": { "type": "string" }
            },
            "tolerations": {
              "type": "array",
              "description": "Tolerations applied to all workloads",
              "items": { "$ref": "#/definitions/toleration" }
            },
            "affinity": {
              "type": "object",
              "description": "Affinity rules applied to all workloads"
            }
          }
        }
      }
    },
    "externalSecrets": {
      "type": "object",
      "description": "Overlay-facing External Secrets metadata (not rendered directly by this chart)",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "secretStoreRef": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "kind": { "type": "string", "enum": ["SecretStore", "ClusterSecretStore"] }
          }
        },
        "refreshInterval": { "type": "string", "default": "1h" },
        "remoteRefs": {
          "type": "object",
          "description": "Map local keys to remote secret paths",
          "additionalProperties": { "type": "string" }
        },
        "targetSecretName": { "type": "string" }
      }
    },
    "rulebricks": {
      "type": "object",
      "properties": {
        "app": {
          "type": "object",
          "properties": {
            "logging": {
              "type": "object",
              "properties": {
                "kafkaBrokers": { "type": "string" },
                "kafkaSsl": { "type": "boolean" },
                "kafkaSasl": {
                  "type": "object",
                  "properties": {
                    "mechanism": {
                      "type": "string",
                      "enum": ["aws-iam", "scram-sha-256", "scram-sha-512", "plain", ""]
                    },
                    "region": { "type": "string" },
                    "username": { "type": "string" },
                    "password": { "type": "string" },
                    "existingSecret": { "type": "string" },
                    "existingSecretUsernameKey": { "type": "string" },
                    "existingSecretPasswordKey": { "type": "string" }
                  }
                }
              }
            },
            "serviceAccount": {
              "type": "object",
              "properties": {
                "create": { "type": "boolean" },
                "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
                "automount": { "type": "boolean" },
                "name": { "type": "string" }
              }
            },
            "podDisruptionBudget": {
              "$ref": "#/definitions/podDisruptionBudget"
            }
          }
        },
        "hps": {
          "type": "object",
          "properties": {
            "serviceAccount": {
              "type": "object",
              "properties": {
                "create": { "type": "boolean" },
                "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
                "automount": { "type": "boolean" },
                "name": { "type": "string" }
              }
            },
            "podDisruptionBudget": {
              "$ref": "#/definitions/podDisruptionBudget"
            },
            "workers": {
              "type": "object",
              "properties": {
                "serviceAccount": {
                  "type": "object",
                  "properties": {
                    "create": { "type": "boolean" },
                    "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
                    "automount": { "type": "boolean" },
                    "name": { "type": "string" }
                  }
                },
                "podDisruptionBudget": {
                  "$ref": "#/definitions/podDisruptionBudget"
                }
              }
            }
          }
        },
        "ingress": {
          "type": "object",
          "properties": {
            "app": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "supabase": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "externalDatabase": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "host": { "type": "string" },
            "port": { "type": ["integer", "string"] },
            "secretRef": { "type": "string" },
            "secretRefKey": {
              "type": "object",
              "properties": {
                "username": { "type": "string" },
                "password": { "type": "string" },
                "database": { "type": "string" }
              }
            }
          }
        },
        "studio": {
          "type": "object",
          "properties": {
            "ingress": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "type": { "type": "string", "enum": ["ingress", "gateway-api"] },
                "className": { "type": "string" },
                "hostname": { "type": "string" },
                "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
                "paths": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": { "type": "string" },
                      "pathType": { "type": "string" }
                    }
                  }
                },
                "gatewayApi": {
                  "type": "object",
                  "properties": {
                    "gatewayName": { "type": "string" },
                    "gatewayNamespace": { "type": "string" },
                    "sectionName": { "type": "string" }
                  }
                },
                "tls": {
                  "type": "object",
                  "properties": {
                    "enabled": { "type": ["boolean", "string"] }
                  }
                }
              }
            },
            "podDisruptionBudget": {
              "$ref": "#/definitions/podDisruptionBudget"
            }
          }
        }
      }
    },
    "kafka": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "external-dns": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "migrations": {
      "type": "object",
      "description": "Configuration for database migration jobs",
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["hook", "deployment", "manual"],
          "default": "hook",
          "description": "Migration job execution strategy"
        },
        "ttlSecondsAfterFinished": {
          "type": "integer",
          "default": 600,
          "description": "Time to keep completed jobs (seconds)"
        },
        "backoffLimit": {
          "type": "integer",
          "default": 3,
          "description": "Number of retries before marking job as failed"
        },
        "restartPolicy": {
          "type": "string",
          "enum": ["OnFailure", "Never"],
          "default": "OnFailure"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "tolerations": {
          "type": "array",
          "description": "Tolerations for migration job pods",
          "items": { "$ref": "#/definitions/toleration" }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "externalDb": {
          "type": "object",
          "description": "External database configuration",
          "properties": {
            "host": { "type": "string" },
            "port": { "type": "string", "default": "5432" },
            "existingSecret": { "type": "string" },
            "existingSecretKey": { "type": "string", "default": "password" }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "title": "Managed Supabase Validation",
      "description": "If Supabase subchart is disabled (managed mode), URL and Access Token are required and must not be empty.",
      "if": {
        "properties": {
          "supabase": {
            "type": "object",
            "properties": {
              "enabled": { "const": false }
            },
            "required": ["enabled"]
          }
        },
        "required": ["supabase"]
      },
      "then": {
        "properties": {
          "global": {
            "type": "object",
            "properties": {
              "supabase": {
                "type": "object",
                "required": ["url", "accessToken"],
                "properties": {
                  "url": { "type": "string", "minLength": 1 },
                  "accessToken": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    {
      "title": "Self-hosted Supabase Validation",
      "description": "If Supabase subchart is enabled (self-hosted mode), JWT Secret is required and must not be empty.",
      "if": {
        "properties": {
          "supabase": {
            "type": "object",
            "properties": {
              "enabled": { "const": true }
            },
            "required": ["enabled"]
          }
        },
        "required": ["supabase"]
      },
      "then": {
        "properties": {
          "global": {
            "type": "object",
            "properties": {
              "supabase": {
                "type": "object",
                "required": ["jwtSecret"],
                "properties": {
                  "jwtSecret": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    {
      "title": "External Kafka Validation",
      "description": "If Kafka subchart is disabled, external brokers must be specified in rulebricks.app.logging.kafkaBrokers and must not be empty.",
      "if": {
        "properties": {
          "kafka": {
            "type": "object",
            "properties": {
              "enabled": { "const": false }
            },
            "required": ["enabled"]
          }
        },
        "required": ["kafka"]
      },
      "then": {
        "properties": {
          "rulebricks": {
            "type": "object",
            "required": ["app"],
            "properties": {
              "app": {
                "type": "object",
                "required": ["logging"],
                "properties": {
                  "logging": {
                    "type": "object",
                    "required": ["kafkaBrokers"],
                    "properties": {
                      "kafkaBrokers": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "title": "AI Feature Validation",
      "description": "If AI is enabled, OpenAI API Key is required and must not be empty.",
      "if": {
        "properties": {
          "global": {
            "type": "object",
            "properties": {
              "ai": {
                "type": "object",
                "properties": {
                  "enabled": { "const": true }
                },
                "required": ["enabled"]
              }
            },
            "required": ["ai"]
          }
        },
        "required": ["global"]
      },
      "then": {
        "properties": {
          "global": {
            "type": "object",
            "properties": {
              "ai": {
                "type": "object",
                "required": ["openaiApiKey"],
                "properties": {
                  "openaiApiKey": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    {
      "title": "Inline Secrets Validation",
      "description": "If no external secretRef is provided (empty string), sensitive values must be provided inline.",
      "if": {
        "properties": {
          "global": {
            "type": "object",
            "properties": {
              "secrets": {
                "type": "object",
                "properties": {
                  "secretRef": { "const": "" }
                },
                "required": ["secretRef"]
              }
            },
            "required": ["secrets"]
          }
        },
        "required": ["global"]
      },
      "then": {
        "properties": {
          "global": {
            "type": "object",
            "required": ["licenseKey"],
            "properties": {
              "licenseKey": { "type": "string", "minLength": 1 },
              "smtp": {
                "type": "object",
                "required": ["user", "pass"],
                "properties": {
                  "user": { "type": "string", "minLength": 1 },
                  "pass": { "type": "string", "minLength": 1 }
                }
              },
              "supabase": {
                "type": "object",
                "required": ["anonKey", "serviceKey"],
                "properties": {
                  "anonKey": { "type": "string", "minLength": 1 },
                  "serviceKey": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    {
      "title": "External DNS Consistency",
      "description": "If external-dns subchart is enabled, global.externalDnsEnabled must also be true.",
      "if": {
        "properties": {
          "external-dns": {
            "type": "object",
            "properties": {
              "enabled": { "const": true }
            },
            "required": ["enabled"]
          }
        },
        "required": ["external-dns"]
      },
      "then": {
        "properties": {
          "global": {
            "type": "object",
            "properties": {
              "externalDnsEnabled": { "const": true }
            },
            "required": ["externalDnsEnabled"]
          }
        }
      }
    },
    {
      "title": "External Auth Validation",
      "description": "If externalAuth is enabled, a Supabase JWT secret is required (sourced from global.supabase.jwtSecret).",
      "if": {
        "properties": {
          "global": {
            "type": "object",
            "properties": {
              "externalAuth": {
                "type": "object",
                "properties": {
                  "enabled": { "const": true }
                },
                "required": ["enabled"]
              }
            },
            "required": ["externalAuth"]
          }
        },
        "required": ["global"]
      },
      "then": {
        "properties": {
          "global": {
            "type": "object",
            "properties": {
              "supabase": {
                "type": "object",
                "required": ["jwtSecret"],
                "properties": {
                  "jwtSecret": { "type": "string", "minLength": 1 }
                }
              }
            },
            "required": ["supabase"]
          }
        }
      }
    },
    {
      "title": "SSO Validation",
      "description": "If SSO is enabled, provider, clientId, and clientSecret are required.",
      "if": {
        "properties": {
          "global": {
            "type": "object",
            "properties": {
              "sso": {
                "type": "object",
                "properties": {
                  "enabled": { "const": true }
                },
                "required": ["enabled"]
              }
            },
            "required": ["sso"]
          }
        },
        "required": ["global"]
      },
      "then": {
        "properties": {
          "global": {
            "type": "object",
            "properties": {
              "sso": {
                "type": "object",
                "required": ["provider", "clientId", "clientSecret"],
                "properties": {
                  "provider": { "type": "string", "minLength": 1 },
                  "clientId": { "type": "string", "minLength": 1 },
                  "clientSecret": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "toleration": {
      "type": "object",
      "description": "Kubernetes toleration",
      "properties": {
        "key": { "type": "string" },
        "operator": { "type": "string", "enum": ["Exists", "Equal"] },
        "value": { "type": "string" },
        "effect": { "type": "string", "enum": ["NoSchedule", "PreferNoSchedule", "NoExecute"] },
        "tolerationSeconds": { "type": "integer" }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "description": "Kubernetes PodDisruptionBudget configuration",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] },
        "maxUnavailable": { "type": ["integer", "string"] }
      }
    },
    "resources": {
      "type": "object",
      "description": "Kubernetes resource requests/limits",
      "properties": {
        "requests": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string" },
            "memory": { "type": "string" }
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string" },
            "memory": { "type": "string" }
          }
        }
      }
    }
  }
}
