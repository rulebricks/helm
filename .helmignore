# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
benchmarks/
# CI-only template-validation values (not part of the chart)
ci/




# NOTE: images/manifest.yaml MUST ship inside the chart tarball

# Editor worktrees (full duplicate chart copies — must not be packaged)
.cursor/
# Generated reports / SBOMs / vendored node_modules — huge, not chart content
# (bloats the Helm release Secret past etcd's ~3 MiB limit).
reports/
