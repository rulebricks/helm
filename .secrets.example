# =============================================================================
# Rulebricks secrets inventory
#
# This file is the canonical list of every credential the Rulebricks chart can
# consume from pre-existing Kubernetes Secrets. The chart never syncs secrets
# itself - it only reads Secrets you provide through the *.secretRef /
# *.existingSecret values documented per section below.
#
# How to use it (pick one):
#   1. Vault-backed (recommended): map each key below to an entry in your
#      secrets platform via the External Secrets Operator. Copy-paste
#      SecretStore/ExternalSecret manifests for AWS Secrets Manager, Azure Key
#      Vault, and GCP Secret Manager live in examples/external-secrets/.
#   2. No vault: copy a section into its own file, fill in the values, and
#      create the Secret directly:
#        kubectl create secret generic <secret-name> -n <namespace> \
#          --from-env-file=<section-file>
#
# Sections marked OPTIONAL are only needed when the corresponding feature is
# enabled. Suggested Secret names use "rulebricks" as the Helm release name -
# any name works as long as the values seam points at it.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Application secret
#    Suggested name : rulebricks-app
#    Values seam    : global.secrets.secretRef
#    Consumed by    : app, HPS, HPS workers, migration job, Supabase auth (SSO)
#    Key names are remappable via global.secrets.secretRefKeys.
# -----------------------------------------------------------------------------

# Rulebricks license key (also used to pull rulebricks/* images; see
# global.licenseKey / the image-pull section of the README).
LICENSE_KEY=

# Admin contact email for the deployment.
EMAIL=

# SMTP credentials for outbound email.
SMTP_USER=
SMTP_PASS=

# Supabase API keys. Self-hosted: derive anon/service keys from the JWT secret
# (HS256, roles "anon" / "service_role"). Managed Supabase: copy them from the
# project's API settings. SUPABASE_SECRET_KEY carries the same value as
# SUPABASE_SERVICE_KEY.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_SECRET_KEY=

# OPTIONAL [managed Supabase] - personal access token for headless supabase CLI.
SUPABASE_ACCESS_TOKEN=

# OPTIONAL [self-hosted Supabase with global.externalAuth.enabled] - the JWT
# signing secret (same value as "secret" in section 2).
JWT_SECRET=

# OPTIONAL [global.sso.enabled] - OIDC client credentials.
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=

# OPTIONAL [external Redis with auth] - password for the external Redis.
REDIS_PASSWORD=

# OPTIONAL [external Kafka with SASL] - broker credentials (alternatively use
# rulebricks.app.logging.kafkaSasl.existingSecret).
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=


# -----------------------------------------------------------------------------
# 2. Supabase JWT secret                        [self-hosted Supabase only]
#    Suggested name : rulebricks-supabase-jwt
#    Values seams   : supabase.secret.jwt.secretRef
#                     global.supabase.secretRef (browser anon key seam; point it
#                     at this same Secret, key "anonKey")
#    Consumed by    : Kong, GoTrue, PostgREST, Realtime, Studio, app
# -----------------------------------------------------------------------------

# JWT signing secret (>= 32 chars) and the anon/service_role JWTs signed by it.
secret=
anonKey=
serviceKey=


# -----------------------------------------------------------------------------
# 3. Postgres credentials                       [self-hosted Supabase only]
#    Suggested name : rulebricks-supabase-db
#    Values seams   : supabase.secret.db.secretRef (bundled Postgres)
#                     supabase.externalDatabase.secretRef (external Postgres;
#                     host/port keys are only read on this seam)
#    Consumed by    : GoTrue, PostgREST, Meta, Realtime, Studio, DB, backups
# -----------------------------------------------------------------------------

username=postgres
password=
database=postgres

# OPTIONAL [external Postgres] - connection endpoint.
host=
port=5432


# -----------------------------------------------------------------------------
# 4. External database bootstrap                [external Postgres only]
#    Suggested name : rulebricks-supabase-db-bootstrap
#    Values seam    : supabase.externalDatabase.bootstrap.secretRef
#    Consumed by    : one-time db-bootstrap hook Job
# -----------------------------------------------------------------------------

master-username=postgres
master-password=
# Password the bootstrap sets for the application role (usually the same value
# as "password" in section 3).
service-password=


# -----------------------------------------------------------------------------
# 5. Supabase dashboard basic auth              [self-hosted Supabase only]
#    Suggested name : rulebricks-supabase-dashboard
#    Values seam    : supabase.secret.dashboard.secretRef
#    Consumed by    : Kong (Studio access)
# -----------------------------------------------------------------------------

username=supabase
password=


# -----------------------------------------------------------------------------
# 6. Supabase auth SMTP                         [self-hosted Supabase only]
#    Suggested name : rulebricks-supabase-smtp
#    Values seam    : supabase.secret.smtp.secretRef
#    Consumed by    : GoTrue (auth emails); usually the same credentials as
#    SMTP_USER/SMTP_PASS in section 1.
# -----------------------------------------------------------------------------

username=
password=


# -----------------------------------------------------------------------------
# 7. Supabase Realtime encryption               [self-hosted Supabase only]
#    Suggested name : rulebricks-supabase-realtime
#    Values seam    : supabase.secret.realtime.secretRef
#    Consumed by    : Realtime
# -----------------------------------------------------------------------------

# 64-char secret key base and 16-char DB encryption key.
SECRET_KEY_BASE=
DB_ENC_KEY=


# -----------------------------------------------------------------------------
# 8. ClickHouse admin password                  [clickhouse.enabled]
#    Suggested name : rulebricks-clickhouse
#    Values seams   : clickhouse.auth.existingSecret (+ existingSecretKey)
#                     rulebricks.app.clickhouse.existingSecret
#                     clickstack.clickhouse.existingSecret (when ClickStack on)
#    Consumed by    : ClickHouse, view-init job, app, clickstack
#    NOTE: do NOT name this <release>-clickhouse-credentials - that exact name
#    stays chart-managed, so a synced Secret would fight Helm for ownership.
# -----------------------------------------------------------------------------

admin-password=


# -----------------------------------------------------------------------------
# 9. FerretDB password                          [clickstack.enabled]
#    Suggested name : rulebricks-ferretdb
#    Values seam    : clickstack.ferretdb.auth.existingSecret (+ existingSecretKey)
#    Consumed by    : FerretDB, HyperDX
# -----------------------------------------------------------------------------

password=
